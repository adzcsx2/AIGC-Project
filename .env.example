# Use a Token from the AutoDL ComfyUI group. Never add "Bearer ".
AUTODL_API_KEY=replace-with-your-comfyui-token

# 可选：本机 Midjourney 代理配置，账号关联与步骤见 docs/midjourney-local.md。
# 保留程序变量名；以下说明和素材名称使用中文。
MJ_SERVER=http://127.0.0.1:6013
# 本地代理密钥，独立生成，不复用 AutoDL Token。
MJ_API_SECRET=
# Discord 服务器和文字频道的数字 ID。
MJ_DISCORD_GUILD_ID=
MJ_DISCORD_CHANNEL_ID=
# 用户凭据仅在本机填写。
MJ_DISCORD_USER_TOKEN=
